# Copy this file to .env and fill in real values. .env is gitignored - never commit real secrets.

# Flask session signing key - generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Keep this stable across restarts/deploys, otherwise every logged-in session is invalidated.
FLASK_SECRET_KEY=

# Site login (who's allowed to open the app at all - separate from the API credentials
# below). One line per user: APP_USER_<NAME>_HASH=<password hash>, where <NAME> becomes
# the lowercase username (e.g. APP_USER_ERDEM_HASH -> username "erdem"). Add as many as needed.
# Generate each hash with:
#   python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
APP_USER_ADMIN_HASH=
APP_USER_ERDEM_HASH=
APP_USER_RAPHAEL_HASH=

# StatsBomb API credentials
STATSBOMB_USER=
STATSBOMB_PASSWORD=

# SkillCorner API credentials
SKILLCORNER_USERNAME=
SKILLCORNER_PASSWORD=

# Flask server config
DEBUG=False
PORT=5000
